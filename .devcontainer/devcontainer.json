{
	"name": "Python 3",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"postCreateCommand": "bash .devcontainer/post_install.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"charliermarsh.ruff"
			],
			"settings": {
				"[python]": {
					"editor.formatOnType": true,
					"editor.defaultFormatter": "charliermarsh.ruff",
					"testing.pytestArgs": [
						"."
					],
					"testing.unittestEnabled": false,
					"testing.pytestEnabled": true
				}
			}
		}
	},
	"postStartCommand": "sudo valkey-server --daemonize yes"
}